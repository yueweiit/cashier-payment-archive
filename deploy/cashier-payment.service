[Unit]
Description=Cashier payment archive FastAPI service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=www
Group=www
WorkingDirectory=/www/wwwroot/cashier-payment-archive
Environment=PYTHONUNBUFFERED=1
ExecStart=/www/wwwroot/cashier-payment-archive/.venv/bin/uvicorn backend.app.main:app --host 0.0.0.0 --port 8011 --workers 1
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT
UMask=0027
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
