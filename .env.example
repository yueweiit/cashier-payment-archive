# 钉钉支出中间表（PostgreSQL，只读账号）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=expense_database
# 可选：钉钉用户 ID/姓名快照表所在数据库，默认为 dingtalk_oa。
DINGTALK_USER_DB_NAME=dingtalk_oa
DB_USER=readonly_user
DB_PASSWORD=replace_me

# 可选：使用其他配置文件。未设置时依次查找项目根目录的 .env 和 env。
# PAYMENT_SOURCE_ENV_FILE=/absolute/path/to/source.env
